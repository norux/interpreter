{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["extension/**/*.ts", "packages/media-web/**/*.ts", "packages/engines-browser/**/*.ts", "packages/presentation-web/**/*.ts", "apps/chrome/**/*.ts", "tests/**/*.ts", "vite.config.ts", "vite.content.config.ts", "vite.chrome.config.ts"],
  "exclude": ["tests/framework/types"]
}
