# Cloud paths use these server keys only when explicitly selected in the popup.
# Never place these keys in extension storage or frontend code.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Non-secret Chrome extension ID from chrome://extensions; export before starting.
# Capture is denied until this exact extension origin is configured.
INTERPRETER_EXTENSION_ID=

# The popup overrides the provider/language/model defaults below per session.
# These defaults apply to clients without a /sessions settings body.
# local (default), openai-direct, luna, or anthropic; no automatic paid fallback.
INTERPRETER_PROVIDER=local

# Text paths choose local (default) or openai ASR. Direct ignores ASR settings.
INTERPRETER_ASR=local
# For openai ASR, set this to gpt-live-transcribe; no local dependencies needed.
INTERPRETER_ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit
# OpenAI ASR expects a language code separately from the prompt's language name.
INTERPRETER_ASR_LANGUAGE=en
# Local weights are downloaded explicitly before Start; no external inference API.
# Luna: gpt-6-luna. Anthropic: explicitly supply an ID accessible to your account.
INTERPRETER_TEXT_MODEL=qwen3:4b-instruct
INTERPRETER_SOURCE_LANGUAGE=English
INTERPRETER_TARGET_LANGUAGE=Korean
# For openai-direct use the API language code, e.g. INTERPRETER_TARGET_LANGUAGE=ko.
