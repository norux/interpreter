# OpenAI direct uses the server key only when explicitly selected below.
# Anthropic is reserved for the next text-adapter implementation.
# Never place these keys in extension storage or frontend code.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Non-secret Chrome extension ID from chrome://extensions; export before starting.
# Capture is denied until this exact extension origin is configured.
INTERPRETER_EXTENSION_ID=

# local (default) or openai-direct; no automatic paid fallback.
INTERPRETER_PROVIDER=local

# Local models are downloaded explicitly before Start; no external inference API.
INTERPRETER_ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit
INTERPRETER_TEXT_MODEL=qwen3:4b-instruct
INTERPRETER_SOURCE_LANGUAGE=English
INTERPRETER_TARGET_LANGUAGE=Korean
# For openai-direct use the API language code, e.g. INTERPRETER_TARGET_LANGUAGE=ko.
