{
  "name": "interpreter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:server": "uv run --locked uvicorn server.app:app --host 127.0.0.1 --port 8765 --ws-max-size 4096 --ws-max-queue 8 --reload",
    "build": "vite build",
    "lint": "biome lint extension tests vite.config.ts && uv run --locked ruff check server tests",
    "typecheck": "tsc --noEmit",
    "test:js": "node --import tsx --test tests/*.test.ts",
    "test:python": "uv run --locked pytest",
    "test:capture-browser": "npm run build && node tests/capture-browser.mjs",
    "test": "npm run test:js && npm run test:python",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
