{
  "manifest_version": 3,
  "name": "Interpreter — selected video",
  "version": "0.1.0",
  "description": "Local selected-video interpretation development build.",
  "minimum_chrome_version": "138",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Interpret selected video" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co"
  },
  "web_accessible_resources": [{ "resources": ["pcm-worklet.js"], "matches": ["http://*/*", "https://*/*"] }]
}
